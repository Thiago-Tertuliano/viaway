NODE_ENV=development
PORT=3001

# PostgreSQL (Railway, Docker ou local)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/viaway?schema=public"

# JWT — autenticação própria (obrigatório com auth habilitada)
# Access: curta duração (padrão 15m). Refresh: longa (padrão 7d), segredo diferente.
JWT_SECRET=
# Opcional: sobrescreve JWT_SECRET só para access
# JWT_ACCESS_SECRET=
# Em produção: obrigatório e deve ser diferente do segredo de access
JWT_REFRESH_SECRET=
# Opcional: reforço de validação
# JWT_ISSUER=viaway
# JWT_AUDIENCE=viaway-app
# JWT_ACCESS_EXPIRES_IN=15m
# JWT_REFRESH_EXPIRES_IN=7d

# Desenvolvimento: desliga JWT e usa usuário fixo (não use em produção)
DISABLE_AUTH=true
DEV_USER_EMAIL=dev@viaway.local
DEV_USER_NOME=Dev Local
