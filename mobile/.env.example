# URL base da API ViaWay (backend em PROJETOS/Viaway/backend, porta 3001 por padrão)
# Em emulador Android, pode ser necessário usar o IP da máquina (ex.: http://10.0.2.2:3001) em vez de localhost.
EXPO_PUBLIC_API_URL=http://localhost:3001/v1

# Google Places API key (somente para testes locais do buscador de lugares).
# Em produção, prefira passar por backend proxy para não expor chave no app.
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=

# Buscador de lugares (cache em memória no app; reiniciar o app limpa o cache)
# TTL em ms. Ex.: 86400000 = 24h
EXPO_PUBLIC_PLACES_CACHE_TTL_MS=86400000
# true/false — desliga cache se false
EXPO_PUBLIC_PLACES_CACHE_ENABLED=true
# Resultados por página (1–20, limite da API)
EXPO_PUBLIC_PLACES_PAGE_SIZE=20
